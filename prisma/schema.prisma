// Prisma Schema for Spendly — Supabase PostgreSQL & Gemini AI UPI Expense Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String         @default("Shreyas Hathiwala")
  email         String         @unique @default("shreyas@hathiwala.com")
  password      String
  role          String         @default("OWNER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  categoryRules CategoryRule[]

  @@map("users")
}

model Transaction {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId           String?  @map("user_id")
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "transactions_userId_fkey")
  date             String
  payee            String   @map("merchant")
  amount           Float
  category         String
  referenceNo      String   @map("upi_ref")
  notes            String?  @map("note") @db.Text
  bankNotification String?  @map("raw_message") @db.Text
  messageId        String   @unique(map: "transactions_messageId_key") @map("email_id")
  type             String
  source           String?  @map("parsed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([referenceNo], map: "transactions_referenceNo_idx")
  @@map("transactions")
}

model CategoryRule {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "category_rules_user_id_fkey")
  category    String
  payees      String[] @default([])
  color       String?
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, category], map: "category_rules_user_id_category_key")
  @@index([category])
  @@map("category_rules")
}
